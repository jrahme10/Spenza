# Supabase remains optional. Without URL/key Spenza runs local-only in IndexedDB.
VITE_SUPABASE_URL=
# Prefer the current publishable key. The legacy ANON key below is still supported by the client wrapper.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_FUNCTION_NAME=finance-ai
